# API keys secret: pre-created in AWS Secrets Manager, managed outside Terraform.
# Update keys any time with:
#   aws secretsmanager put-secret-value --secret-id mytripadvision-prod/app \
#     --secret-string '{"OPENAI_API_KEY":"...","TAVILY_API_KEY":"...",...}' \
#     --region ap-southeast-2
#
# Terraform only reads the ARN — the secret value never appears in state or plan output.

data "aws_secretsmanager_secret" "api_keys" {
  name = "${local.name}/app"
}

# DB password is generated by Terraform and stored in its own secret so it can
# be rotated independently of the API keys.
resource "aws_secretsmanager_secret" "db" {
  name                    = "${local.name}/db"
  description             = "${var.project} ${var.environment}: database password"
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id     = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({ DB_PASSWORD = random_password.db.result })
}
