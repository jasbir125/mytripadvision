# Copy to terraform.tfvars (that file is git-ignored) and fill in the values.
# Never commit real keys.

aws_region = "us-east-1"

# Who may open the web page. Use your own IP: curl -s https://checkip.amazonaws.com
allowed_cidrs = ["203.0.113.10/32"]

# Bedrock models. Check what your account can use:
#   aws bedrock list-inference-profiles --region us-east-1
bedrock_model_id       = "us.amazon.nova-lite-v1:0"
bedrock_final_model_id = "us.amazon.nova-pro-v1:0"

# API keys (stored in AWS Secrets Manager)
tavily_api_key        = ""
openweather_api_key   = ""
aviationstack_api_key = ""

# Optional
# certificate_arn         = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# db_deletion_protection  = true
# db_skip_final_snapshot  = false
# desired_count           = 2
