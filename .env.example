# Names only. Copy to .env and fill in the values; .env is never committed.
# Spring Boot does not read this file by itself: `docker compose` does, or run
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# Database (postgresql://user:password@host:port/database). Without it DB_URL/DB_USERNAME/DB_PASSWORD are used.
DATABASE_URL=

# LLM: openai, groq (default) or bedrock. Default models: gpt-4o-mini (openai), openai/gpt-oss-120b (groq),
# us.amazon.nova-lite-v1:0 and, for the final answer, us.amazon.nova-pro-v1:0 (bedrock)
LLM_PROVIDER=
LLM_MODEL=
LLM_FINAL_MODEL=
# bedrock only: region (default us-east-1). AWS credentials come from the AWS default chain, not from this file.
AWS_REGION=
OPENAI_API_KEY=
GROQ_API_KEY=

# Data providers
AVIATIONSTACK_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# Behaviour
DEFAULT_ORIGIN_IATA=
HUMAN_REVIEW=
